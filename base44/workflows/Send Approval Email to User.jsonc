{
  "name": "Send Approval Email to User",
  "description": "Sends a branded HTML approval email to the user when their UserApplication status is changed to Approved.",
  "trigger": {
    "condition": "${ ((.trigger.data.status == \"Approved\") and (.trigger.old_data.status != \"Approved\")) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "UserApplication"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "send_approval_email_to_user",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "sendAccessApprovedEmail",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "sendAccessApprovedEmail"
  }
}