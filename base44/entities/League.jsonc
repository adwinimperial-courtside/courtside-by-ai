{
  "name": "League",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Name of the league"
    },
    "season": {
      "type": "string",
      "description": "Season year (e.g., 2024-2025)"
    },
    "group_id": {
      "type": "string",
      "description": "Optional LeagueGroup ID this league (season) belongs to. LEAGUE_GROUP_V1"
    },
    "is_archived": {
      "type": "boolean",
      "description": "True when this season is finished/archived. Absent or false means the season is current. LEAGUE_GROUP_V2"
    },
    "description": {
      "type": "string",
      "description": "League description"
    },
    "owner_user_id": {
      "type": "string",
      "description": "User ID of the league owner"
    },
    "owner_email": {
      "type": "string",
      "description": "Email of the league owner"
    },
    "owner_name": {
      "type": "string",
      "description": "Name of the league owner"
    },
    "start_date": {
      "type": "string",
      "format": "date",
      "description": "SEASON_DATES_V1 - first day of the season. Season status is derived from the dates and never stored: before start_date is Upcoming, after it is Active, and Ended only once end_date exists and has passed."
    },
    "end_date": {
      "type": "string",
      "format": "date",
      "description": "SEASON_DATES_V1 - optional last day of the season. Many grassroots leagues do not know this at signup, so it may be empty."
    },
    "registration_deadline": {
      "type": "string",
      "format": "date",
      "description": "SEASON_DATES_V1 - last day teams can apply through the public registration link. After this, coach registration closes but player and fan registration stay open."
    },
    "registration_mode": {
      "type": "string",
      "enum": [
        "open",
        "closed"
      ],
      "description": "SEASON_DATES_V1 - open means teams apply through the public link and the organizer approves each one. closed means the organizer creates the teams and sends each coach a code. Switchable at any time."
    },
    "team_slots": {
      "type": "number",
      "description": "SEASON_DATES_V1 - how many team slots the organizer is aiming for. A counter only, not a hard cap: applications keep arriving until the registration deadline and the organizer decides who is in."
    }
  },
  "required": [
    "name",
    "season"
  ],
  "rls": {
    "delete": {
      "$or": [
        {
          "user_condition": {
            "data.user_type": "app_admin"
          }
        },
        {
          "user_condition": {
            "data.user_type": "league_admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "data.user_type": "app_admin"
          }
        },
        {
          "user_condition": {
            "data.user_type": "league_admin"
          }
        }
      ]
    },
    "write": {
      "$or": [
        {
          "user_condition": {
            "data.user_type": "app_admin"
          }
        },
        {
          "user_condition": {
            "data.user_type": "league_admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "data.user_type": "app_admin"
          }
        },
        {
          "user_condition": {
            "data.user_type": "ops_admin"
          }
        },
        {
          "user_condition": {
            "data.user_type": "league_admin"
          }
        }
      ]
    }
  }
}