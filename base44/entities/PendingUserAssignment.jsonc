{
  "name": "PendingUserAssignment",
  "type": "object",
  "properties": {
    "email": {
      "type": "string",
      "description": "Email of the invited user"
    },
    "user_type": {
      "type": "string",
      "enum": [
        "app_admin",
        "league_admin",
        "viewer"
      ],
      "description": "Pre-assigned user type"
    },
    "assigned_league_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Pre-assigned league IDs"
    },
    "applied": {
      "type": "boolean",
      "default": false,
      "description": "Whether assignment has been applied to actual user"
    }
  },
  "required": [
    "email"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "data.user_type": "app_admin"
          }
        },
        {
          "user_condition": {
            "data.user_type": "ops_admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "data.user_type": "app_admin"
          }
        },
        {
          "user_condition": {
            "data.user_type": "ops_admin"
          }
        },
        {
          "data.email": "{{user.email}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "data.user_type": "app_admin"
          }
        },
        {
          "user_condition": {
            "data.user_type": "ops_admin"
          }
        },
        {
          "data.email": "{{user.email}}"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "data.user_type": "app_admin"
          }
        },
        {
          "user_condition": {
            "data.user_type": "ops_admin"
          }
        }
      ]
    }
  }
}