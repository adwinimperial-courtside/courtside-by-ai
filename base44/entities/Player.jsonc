{
  "name": "Player",
  "type": "object",
  "properties": {
    "league_id": {
      "type": "string",
      "description": "SECURITY_F5_B - league/season this row belongs to (from Game.league_id for GameLog/PlayerStats, Team.league_id for Player). Optional; empty on existing rows."
    },
    "name": {
      "type": "string",
      "description": "Player full name"
    },
    "team_id": {
      "type": "string",
      "description": "Reference to the team"
    },
    "jersey_number": {
      "type": "number",
      "description": "Player jersey number"
    },
    "position": {
      "type": "string",
      "enum": [
        "PG",
        "SG",
        "SF",
        "PF",
        "C"
      ],
      "description": "Player position"
    },
    "photo_url": {
      "type": "string",
      "description": "URL of the player's profile photo uploaded by a league admin. Displayed across the app wherever the player appears. When empty, the app falls back to showing the jersey number circle."
    }
  },
  "required": [
    "name",
    "team_id",
    "jersey_number"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "data.user_type": "app_admin"
          }
        },
        {
          "user_condition": {
            "data.user_type": "league_admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "data.user_type": "app_admin"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "data.user_type": "league_admin"
              }
            },
            {
              "data.league_id": {
                "$in": "{{user.data.assigned_league_ids}}"
              }
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "data.user_type": "league_admin"
              }
            },
            {
              "data.league_id": {
                "$in": [
                  null,
                  ""
                ]
              }
            }
          ]
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "data.user_type": "app_admin"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "data.user_type": "league_admin"
              }
            },
            {
              "data.league_id": {
                "$in": "{{user.data.assigned_league_ids}}"
              }
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "data.user_type": "league_admin"
              }
            },
            {
              "data.league_id": {
                "$in": [
                  null,
                  ""
                ]
              }
            }
          ]
        }
      ]
    }
  }
}