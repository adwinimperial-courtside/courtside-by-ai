{
  "name": "TacticalBriefing",
  "type": "object",
  "properties": {
    "league_id": {
      "type": "string",
      "description": "Reference to the league"
    },
    "team_id": {
      "type": "string",
      "description": "Reference to the team"
    },
    "opponent_id": {
      "type": "string",
      "description": "Reference to the opponent team"
    },
    "briefing_content": {
      "type": "string",
      "description": "Generated tactical briefing content"
    },
    "generated_date": {
      "type": "string",
      "format": "date-time",
      "description": "When the briefing was generated"
    },
    "team_data": {
      "type": "object",
      "description": "Team statistics used for generation"
    },
    "opponent_data": {
      "type": "object",
      "description": "Opponent statistics used for generation"
    }
  },
  "required": [
    "league_id",
    "team_id",
    "opponent_id",
    "briefing_content",
    "generated_date"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "data.user_type": "app_admin"
          }
        },
        {
          "user_condition": {
            "data.user_type": "ops_admin"
          }
        },
        {
          "data.league_id": {
            "$in": "{{user.data.assigned_league_ids}}"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "data.user_type": "app_admin"
          }
        },
        {
          "user_condition": {
            "data.user_type": "ops_admin"
          }
        },
        {
          "data.league_id": {
            "$in": "{{user.data.assigned_league_ids}}"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "data.user_type": "app_admin"
      }
    },
    "delete": {
      "user_condition": {
        "data.user_type": "app_admin"
      }
    }
  }
}