{
  "name": "OverlaySettings",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "Owner user ID \u2014 one record per user"
    },
    "league_id": {
      "type": "string",
      "description": "Selected league for this overlay configuration"
    },
    "logo_url": {
      "type": "string",
      "description": "URL to the overlay logo image (app/sponsor logo)"
    },
    "league_logo_url": {
      "type": "string",
      "description": "URL to the league logo image"
    },
    "logo_enabled": {
      "type": "boolean",
      "default": true,
      "description": "Whether the sponsor/app logo is shown on the overlay"
    },
    "league_logo_enabled": {
      "type": "boolean",
      "default": true,
      "description": "Whether the league logo is shown on the overlay"
    },
    "ticker_text": {
      "type": "string",
      "description": "Scrolling ticker text for advertisements and announcements"
    },
    "ticker_enabled": {
      "type": "boolean",
      "default": true,
      "description": "Whether the ticker is shown on the overlay"
    },
    "clock_enabled": {
      "type": "boolean",
      "default": true,
      "description": "Whether the game clock is shown on the overlay scoreboard"
    },
    "timeout_panel_enabled": {
      "type": "boolean",
      "default": true,
      "description": "Whether the timeout team-stats panel is shown on the overlay"
    },
    "break_panel_enabled": {
      "type": "boolean",
      "default": true,
      "description": "Whether the end-of-period player leaders panel is shown on the overlay"
    },
    "starters_panel_enabled": {
      "type": "boolean",
      "default": true,
      "description": "Whether the pre-tipoff starting five panel is shown on the overlay"
    },
    "player_cards_enabled": {
      "type": "boolean",
      "default": true,
      "description": "Whether player highlight cards are shown on the overlay"
    },
    "sponsor_logos": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "LIVE_OVERLAY_V2 - up to 8 sponsor logo image URLs that rotate on the phone-stream overlay"
    }
  },
  "required": [],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "data.user_type": "app_admin"
          }
        },
        {
          "$and": [
            {
              "$or": [
                {
                  "user_condition": {
                    "data.user_type": "league_admin"
                  }
                },
                {
                  "user_condition": {
                    "data.user_type": "video_admin"
                  }
                }
              ]
            },
            {
              "data.league_id": {
                "$in": "{{user.data.assigned_league_ids}}"
              }
            }
          ]
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "data.user_type": "app_admin"
          }
        },
        {
          "$and": [
            {
              "$or": [
                {
                  "user_condition": {
                    "data.user_type": "league_admin"
                  }
                },
                {
                  "user_condition": {
                    "data.user_type": "video_admin"
                  }
                }
              ]
            },
            {
              "data.league_id": {
                "$in": "{{user.data.assigned_league_ids}}"
              }
            }
          ]
        }
      ]
    },
    "delete": {
      "user_condition": {
        "data.user_type": "app_admin"
      }
    }
  }
}