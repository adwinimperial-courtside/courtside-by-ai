{
  "name": "OverlaySettings",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "Owner user ID \u2014 one record per user"
    },
    "league_id": {
      "type": "string",
      "description": "Selected league for this overlay configuration"
    },
    "logo_url": {
      "type": "string",
      "description": "URL to the overlay logo image (app/sponsor logo)"
    },
    "league_logo_url": {
      "type": "string",
      "description": "URL to the league logo image"
    },
    "logo_enabled": {
      "type": "boolean",
      "default": true,
      "description": "Whether the sponsor/app logo is shown on the overlay"
    },
    "league_logo_enabled": {
      "type": "boolean",
      "default": true,
      "description": "Whether the league logo is shown on the overlay"
    },
    "ticker_text": {
      "type": "string",
      "description": "Scrolling ticker text for advertisements and announcements"
    },
    "ticker_enabled": {
      "type": "boolean",
      "default": true,
      "description": "Whether the ticker is shown on the overlay"
    },
    "clock_enabled": {
      "type": "boolean",
      "default": true,
      "description": "Whether the game clock is shown on the overlay scoreboard"
    },
    "timeout_panel_enabled": {
      "type": "boolean",
      "default": true,
      "description": "Whether the timeout team-stats panel is shown on the overlay"
    },
    "break_panel_enabled": {
      "type": "boolean",
      "default": true,
      "description": "Whether the end-of-period player leaders panel is shown on the overlay"
    },
    "starters_panel_enabled": {
      "type": "boolean",
      "default": true,
      "description": "Whether the pre-tipoff starting five panel is shown on the overlay"
    },
    "player_cards_enabled": {
      "type": "boolean",
      "default": true,
      "description": "Whether player highlight cards are shown on the overlay"
    },
    "sponsor_logos": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "LIVE_OVERLAY_V2 - legacy list of sponsor logo URLs. Replaced by sponsors (OVERLAY_V3_FIELDS); still read as a fallback"
    },
    "sponsors": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "description": "Sponsor logo image URL"
          },
          "name": {
            "type": "string",
            "description": "Sponsor name, shown in settings menus and used as the logo's alt text"
          },
          "in_footer": {
            "type": "boolean",
            "description": "true = logo shown in the overlay footer (max 4 sponsors)"
          }
        }
      },
      "description": "OVERLAY_V3_FIELDS - the league's sponsors in footer order, max 8. Logos never rotate: each sponsor has a fixed spot"
    },
    "timeout_sponsor_url": {
      "type": "string",
      "description": "OVERLAY_V3_FIELDS - logo URL of the sponsor presenting the timeout strip. Blank = no sponsor"
    },
    "break_sponsor_url": {
      "type": "string",
      "description": "OVERLAY_V3_FIELDS - logo URL of the sponsor presenting the end-of-quarter strip. Blank = no sponsor"
    },
    "ticker_mode": {
      "type": "string",
      "enum": [
        "off",
        "stopped",
        "always"
      ],
      "description": "OVERLAY_V3_FIELDS - when the ticker shows: off, stopped (only when play stops: before tip-off, timeouts, breaks) or always. Blank = older records, follow ticker_enabled"
    }
  },
  "required": [],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "data.user_type": "app_admin"
          }
        },
        {
          "$and": [
            {
              "$or": [
                {
                  "user_condition": {
                    "data.user_type": "league_admin"
                  }
                },
                {
                  "user_condition": {
                    "data.user_type": "video_admin"
                  }
                }
              ]
            },
            {
              "data.league_id": {
                "$in": "{{user.data.assigned_league_ids}}"
              }
            }
          ]
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "data.user_type": "app_admin"
          }
        },
        {
          "$and": [
            {
              "$or": [
                {
                  "user_condition": {
                    "data.user_type": "league_admin"
                  }
                },
                {
                  "user_condition": {
                    "data.user_type": "video_admin"
                  }
                }
              ]
            },
            {
              "data.league_id": {
                "$in": "{{user.data.assigned_league_ids}}"
              }
            }
          ]
        }
      ]
    },
    "delete": {
      "user_condition": {
        "data.user_type": "app_admin"
      }
    }
  }
}