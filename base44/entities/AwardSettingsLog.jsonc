{
  "name": "AwardSettingsLog",
  "type": "object",
  "properties": {
    "league_id": {
      "type": "string",
      "description": "Reference to the league"
    },
    "league_name": {
      "type": "string",
      "description": "Cached league name"
    },
    "changed_by": {
      "type": "string",
      "description": "Email of the user who saved"
    },
    "changed_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the save occurred"
    },
    "changes": {
      "type": "array",
      "description": "List of changed fields",
      "items": {
        "type": "object",
        "properties": {
          "field_key": {
            "type": "string"
          },
          "field_label": {
            "type": "string"
          },
          "old_value": {
            "type": "string"
          },
          "new_value": {
            "type": "string"
          }
        }
      }
    }
  },
  "required": [
    "league_id",
    "changed_by",
    "changed_at"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "data.user_type": "app_admin"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "data.user_type": "league_admin"
              }
            },
            {
              "data.league_id": {
                "$in": "{{user.data.assigned_league_ids}}"
              }
            }
          ]
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "data.user_type": "app_admin"
          }
        },
        {
          "user_condition": {
            "data.user_type": "ops_admin"
          }
        },
        {
          "data.league_id": {
            "$in": "{{user.data.assigned_league_ids}}"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "data.user_type": "app_admin"
      }
    },
    "delete": {
      "user_condition": {
        "data.user_type": "app_admin"
      }
    }
  }
}