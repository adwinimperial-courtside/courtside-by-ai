{
  "name": "LeagueAccessRequest",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "Reference to the user"
    },
    "user_email": {
      "type": "string",
      "description": "Email of the user"
    },
    "user_name": {
      "type": "string",
      "description": "Name of the user"
    },
    "requested_league_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "League IDs requested by user"
    },
    "requested_roles": {
      "type": "object",
      "description": "Map of league_id to requested role (player, coach, viewer)"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected"
      ],
      "default": "pending",
      "description": "Request status"
    }
  },
  "required": [
    "user_id",
    "user_email",
    "requested_league_ids"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "data.user_type": "app_admin"
          }
        },
        {
          "user_condition": {
            "data.user_type": "ops_admin"
          }
        },
        {
          "created_by": "{{user.email}}"
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "data.user_type": "app_admin"
          }
        },
        {
          "user_condition": {
            "data.user_type": "ops_admin"
          }
        },
        {
          "created_by": "{{user.email}}"
        },
        {
          "data.user_email": "{{user.email}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "data.user_type": "app_admin"
          }
        },
        {
          "user_condition": {
            "data.user_type": "ops_admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "data.user_type": "app_admin"
      }
    }
  }
}