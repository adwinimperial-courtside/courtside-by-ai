{
  "name": "PlatformStats",
  "type": "object",
  "properties": {
    "games": {
      "type": "number",
      "description": "Completed games across the platform"
    },
    "leagues": {
      "type": "number",
      "description": "Leagues (league groups plus ungrouped legacy leagues)"
    },
    "users": {
      "type": "number",
      "description": "Registered users"
    },
    "teams": {
      "type": "number",
      "description": "Teams across all seasons"
    },
    "counted_at": {
      "type": "string",
      "format": "date-time",
      "description": "When these numbers were counted"
    }
  },
  "required": [
    "counted_at"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "data.user_type": "app_admin"
      }
    },
    "read": {
      "user_condition": {
        "data.user_type": "app_admin"
      }
    },
    "update": {
      "user_condition": {
        "data.user_type": "app_admin"
      }
    },
    "delete": {
      "user_condition": {
        "data.user_type": "app_admin"
      }
    }
  }
}