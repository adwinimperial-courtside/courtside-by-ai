{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "admin",
        "user"
      ],
      "default": "user"
    },
    "phone": {
      "type": "string"
    },
    "phone_verified": {
      "type": "boolean",
      "default": false,
      "rls": {
        "write": {
          "user_condition": {
            "data.user_type": "app_admin"
          }
        }
      }
    },
    "phone_verify_code": {
      "type": "string"
    },
    "phone_verify_expires": {
      "type": "string"
    },
    "privacy_terms_accepted": {
      "type": "boolean",
      "description": "CONSENT_FIELDS_V1 - true once the user has accepted the Terms and Privacy Policy"
    },
    "privacy_terms_accepted_at": {
      "type": "string",
      "format": "date-time",
      "description": "CONSENT_FIELDS_V1 - when the user accepted the Terms and Privacy Policy"
    },
    "marketing_email_consent": {
      "type": "boolean",
      "description": "CONSENT_FIELDS_V1 - optional opt-in to marketing emails"
    },
    "marketing_email_consent_at": {
      "type": "string",
      "format": "date-time",
      "description": "CONSENT_FIELDS_V1 - when the user opted in to marketing emails"
    },
    "consent_version": {
      "type": "string",
      "description": "CONSENT_FIELDS_V1 - version of the consent text the user accepted, for example 2026-04-privacy-consent-v1"
    },
    "user_type": {
      "type": "string",
      "description": "SECURITY_F8_V1 - app role. Only app_admin or backend functions may change it.",
      "rls": {
        "write": {
          "user_condition": {
            "data.user_type": "app_admin"
          }
        }
      }
    },
    "assigned_league_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "SECURITY_F8_V1 - leagues this user belongs to. Only app_admin or backend functions may change it.",
      "rls": {
        "write": {
          "user_condition": {
            "data.user_type": "app_admin"
          }
        }
      }
    },
    "league_role_map": {
      "type": "object",
      "description": "SECURITY_F8_V1 - per-league role map. Only app_admin or backend functions may change it.",
      "rls": {
        "write": {
          "user_condition": {
            "data.user_type": "app_admin"
          }
        }
      }
    }
  },
  "rls": {
    "update": {
      "user_condition": {
        "data.user_type": "app_admin"
      }
    },
    "delete": {
      "user_condition": {
        "data.user_type": "app_admin"
      }
    }
  }
}