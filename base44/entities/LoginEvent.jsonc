{
  "name": "LoginEvent",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "ID of the user who logged in"
    },
    "user_email": {
      "type": "string",
      "description": "Email of the user"
    },
    "full_name": {
      "type": "string",
      "description": "Full name of the user"
    },
    "user_type": {
      "type": "string",
      "description": "Role/type of the user"
    },
    "logged_at": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp of the login"
    }
  },
  "required": [
    "user_id",
    "user_email",
    "logged_at"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "data.user_type": "app_admin"
      }
    },
    "read": {
      "user_condition": {
        "data.user_type": "app_admin"
      }
    },
    "update": {
      "user_condition": {
        "data.user_type": "app_admin"
      }
    },
    "delete": {
      "user_condition": {
        "data.user_type": "app_admin"
      }
    }
  }
}