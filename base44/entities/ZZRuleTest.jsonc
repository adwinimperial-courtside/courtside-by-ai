{
  "name": "ZZRuleTest",
  "type": "object",
  "properties": {
    "league_id": {
      "type": "string",
      "description": "test"
    },
    "label": {
      "type": "string",
      "description": "test"
    }
  },
  "required": [],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "data.user_type": "app_admin"
          }
        },
        {
          "user_condition": {
            "data.user_type": "league_admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "data.user_type": "app_admin"
          }
        },
        {
          "user_condition": {
            "data.user_type": "league_admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "data.user_type": "app_admin"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "data.user_type": "league_admin"
              }
            },
            {
              "$or": [
                {
                  "data.league_id": {
                    "$in": "{{user.data.assigned_league_ids}}"
                  }
                },
                {
                  "data.league_id": null
                }
              ]
            }
          ]
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "data.user_type": "app_admin"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "data.user_type": "league_admin"
              }
            },
            {
              "$or": [
                {
                  "data.league_id": {
                    "$in": "{{user.data.assigned_league_ids}}"
                  }
                },
                {
                  "data.league_id": {
                    "$in": [
                      null,
                      ""
                    ]
                  }
                }
              ]
            }
          ]
        }
      ]
    }
  }
}